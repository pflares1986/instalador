import ipywidgets as widgets
from IPython.display import display, HTML, clear_output
import yt_dlp

# UI elements
youtube_url_input = widgets.Text(
    value='',
    placeholder='Paste YouTube URL here',
    description='YouTube URL:',
    disabled=False
)

download_button = widgets.Button(
    description='Download MP3',
    disabled=False,
    button_style='success', 
    tooltip='Click to download MP3',
    icon='download'
)

output_area = widgets.Output()
progress_bar = widgets.FloatProgress(
    value=0.0,
    min=0.0,
    max=1.0,
    description='Progress:',
    bar_style='info',
    orientation='horizontal'
)

# Display UI
display(youtube_url_input, download_button, progress_bar, output_area)

# Download logic
def download_mp3(b):
    with output_area:
        clear_output(wait=True)
        youtube_url = youtube_url_input.value
        if not youtube_url:
            print("Please enter a YouTube URL.")
            return

        print(f"Attempting to download: {youtube_url}")
        progress_bar.value = 0.0

        ydl_opts = {
            'format': 'bestaudio/best',
            'postprocessors': [{
                'key': 'FFmpegExtractAudio',
                'preferredcodec': 'mp3',
                'preferredquality': '192',
            }],
            'outtmpl': {'default': '%(title)s.%(ext)s'},
            'progress_hooks': [lambda d: update_progress(d, progress_bar, output_area)],
            'quiet': True,  # Suppress console output from yt-dlp itself
            'noprogress': True, # Disable yt-dlp's own progress bar
            # Removed 'logger': yt_dlp.utils.StdLogger() as it's causing an AttributeError
            'postprocessor_hooks': [lambda d: update_postprocessor_progress(d, progress_bar, output_area)] # For post-processing progress
        }

        try:
            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                info_dict = ydl.extract_info(youtube_url, download=True)
                file_name = ydl.prepare_filename(info_dict)
                # Replace .webm or .m4a with .mp3 in the final name
                mp3_file_name = file_name.rsplit('.', 1)[0] + '.mp3'
                print(f"Download complete! File saved as: {mp3_file_name}")
                progress_bar.value = 1.0
                # Create a download link for the user
                display(HTML(f'<a href="{mp3_file_name}" download="{mp3_file_name}">Click here to download {mp3_file_name}</a>'))

        except Exception as e:
            print(f"An error occurred: {e}")
            progress_bar.value = 0.0

def update_progress(d, progress_bar_widget, output_widget):
    if d['status'] == 'downloading':
        total_bytes = d.get('total_bytes') or d.get('total_bytes_estimate')
        if total_bytes:
            downloaded_bytes = d.get('downloaded_bytes', 0)
            progress = downloaded_bytes / total_bytes
            progress_bar_widget.value = progress
            with output_widget:
                clear_output(wait=True)
                print(f"Downloading... {progress:.2%}")
    elif d['status'] == 'finished':
        progress_bar_widget.value = 1.0
        with output_widget:
            clear_output(wait=True)
            print("Download finished, starting conversion...")

def update_postprocessor_progress(d, progress_bar_widget, output_widget):
    # yt-dlp doesn't expose detailed progress for FFmpeg post-processing by default.
    # We can assume it's doing work and show some progress.
    if d['status'] == 'started':
        progress_bar_widget.value = 0.9 # Indicate conversion is in progress
        with output_widget:
            clear_output(wait=True)
            print("Conversion started (this might take a moment)...")
    elif d['status'] == 'finished':
        progress_bar_widget.value = 1.0
        with output_widget:
            clear_output(wait=True)
            print("Conversion finished.")


# Attach the event handler to the button
download_button.on_click(download_mp3)
}
